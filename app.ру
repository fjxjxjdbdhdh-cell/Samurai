def ask_ai(question):
    try:
        trades = load_trades()
        labeled = [t for t in trades if t.get("outcome") in ("win", "loss")]
        wins = sum(1 for t in labeled if t["outcome"] == "win")
        winrate = round(wins / len(labeled) * 100) if labeled else 0

        stats = load_daily_stats()
        tactics = load_tactics()
        insights = load_insights()

        context = (
            f"КОНТЕКСТ: Сделок всего: {len(trades)}. "
            f"Винрейт: {winrate}%. "
            f"Сегодня авто-сделок: {stats.get('auto_trades', 0)}. "
            f"Тактик в базе: {len(tactics)}. "
            f"Инсайтов: {len(insights)}. "
            f"Бот использует 8 правил входа, генетический алгоритм, трейлинг-стоп, "
            f"фильтр спреда и таймаут 4 часа для сделок. "
            f"DeepSeek AI управляет TP/SL и принимает решения о входе/выходе. "
            f"ОТВЕЧАЙ КАК ЧЕЛОВЕК. Ты - часть торгового ИИ. Ты самообучаешься."
        )

        response = requests.post(
            "https://openrouter.ai/api/v1/chat/completions",
            headers={
                "Authorization": f"Bearer {DEEPSEEK_API_KEY}",
                "Content-Type": "application/json",
            },
            json={
                "model": "deepseek/deepseek-chat",
                "messages": [
                    {"role": "system", "content": context},
                    {"role": "user", "content": question},
                ],
                "temperature": 0.5,
                "max_tokens": 500,
            },
            timeout=30,
        )

        if response.status_code == 200:
            return response.json()["choices"][0]["message"]["content"].strip()
        return f"Ошибка API: {response.status_code}"
    except Exception as e:
        return f"Ошибка связи с AI. Попробуйте позже."


