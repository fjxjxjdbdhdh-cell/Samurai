@app.route("/api/vip/status")
def api_vip_status():
    email = request.args.get("email", "")
    if not email:
        return jsonify({"error": "Укажите email"}), 400
    
    users = load_users()
    user = users.get(email, {})
    tier = user.get("tier", "free")
    expires = user.get("vip_expires", "")
    
    days_left = 0
    if expires and tier == "vip":
        try:
            expiry_date = datetime.strptime(expires, "%d.%m.%Y")
            days_left = (expiry_date - datetime.now(MSK)).days
        except:
            pass
    
    return jsonify({
        "tier": tier,
        "expires": expires,
        "days_left": max(0, days_left),
    })


