def api_trade():
    data = request.get_json() or {}
    symbol = data.get("symbol", "XAUUSD")
    signal = data.get("signal", "BUY")
    price = float(data.get("price", 0))
    sl = float(data.get("sl", 0))
    tp = float(data.get("tp", 0))
    lot = float(data.get("lot", 0.02))
    result = open_order(symbol, signal, price, sl, tp, lot)
    if result.get("success"):
        with _lock:
            trades = load_trades()
            trades.append({
                "ticket": result["ticket"], "signal": signal, "symbol": symbol,
                "price": price, "sl": sl, "tp": tp, "lot": lot,
                "time": datetime.now(MSK).strftime("%H:%M"), "username": data.get("username", ""),
            })
            save_trades(trades)
        return jsonify({"success": True, "ticket": result["ticket"]})
    return jsonify({"error": result.get("error", "Ошибка")})

