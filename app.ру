    trades = load_trades()
    # Добавляем profit для отображения в истории
    for t in trades:
        if t.get("outcome") == "win" and "profit" not in t:
            # Грубый расчёт профита, если нет точной цифры
            t["profit"] = round(abs(t.get("tp", 0) - t.get("price", 0)), 2) if t.get("tp") else 0
        elif t.get("outcome") == "loss" and "profit" not in t:
            t["profit"] = round(-abs(t.get("sl", 0) - t.get("price", 0)), 2) if t.get("sl") else 0
    return jsonify({"trades": list(reversed(trades[-50:]))})

