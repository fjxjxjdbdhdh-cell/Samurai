class AutoTrader:
    def __init__(self):
        self.last_trade_time = None
        self.stats = load_daily_stats()

    def reset_daily(self):
        today = str(datetime.now(MSK).date())
        if self.stats.get("date") != today:
            self.stats = {"date": today, "auto_trades": 0, "auto_pnl": 0.0, "start_balance": 0.0}
            save_daily_stats(self.stats)
            logger.info(f"🔄 Новый день! Сброс статистики.")

    def can_trade(self):
        self.reset_daily()
        if self.stats.get("auto_trades", 0) >= MAX_TRADES_PER_DAY:
            logger.info(f"⏸ Лимит сделок ({MAX_TRADES_PER_DAY})"); return False
        if self.stats.get("auto_pnl", 0) >= DAILY_PROFIT_TARGET:
            logger.info(f"🏆 Дневной профит достигнут (+${DAILY_PROFIT_TARGET})"); return False
        if self.stats.get("auto_pnl", 0) <= DAILY_LOSS_LIMIT:
            logger.info(f"🛑 Дневной лимит убытков (${DAILY_LOSS_LIMIT})"); return False
        if self.check_daily_loss_percent():
            logger.info(f"🛑 КРИТИЧЕСКИЙ УБЫТОК 7%! Авто-трейдинг отключен."); return False
        return True

    def check_daily_loss_percent(self):
        acc = get_account_info()
        balance = acc.get('balance', 200)
        start_balance = self.stats.get("start_balance", balance)
        if start_balance == 0: # Первый запуск за день
            self.stats["start_balance"] = balance
            save_daily_stats(self.stats)
            return False
        pnl_percent = ((balance - start_balance) / start_balance) * 100 if start_balance > 0 else 0
        if pnl_percent <= MAX_DAILY_LOSS_PERCENT:
            global AUTO_TRADING_ENABLED
            AUTO_TRADING_ENABLED = False
            tg_send(f"🚨 АВАРИЯ! Потеря {pnl_percent:.2f}% депозита. Авто-трейдинг ОТКЛЮЧЕН до 00:00 МСК.")
            return True
        return False

    def manage_open_trades(self):
        """Проверяет открытые сделки и решает, нужно ли закрыть."""
        positions = get_positions()
        if not positions: return

        # Анализируем только первую позицию
        pos = positions[0]
        pos_info = f"Тип: {pos['type']}, Цена открытия: {pos['price_open']}, Текущая цена: {pos['price_current']}, Прибыль: ${pos['profit']}, SL: {pos['sl']}, TP: {pos['tp']}"

        rates = mt5.copy_rates_from_pos("XAUUSD", mt5.TIMEFRAME_M5, 0, 50)
        df = pd.DataFrame(rates)
        df['ema20'] = df['close'].ewm(span=20, adjust=False).mean()
        df['atr'] = (df['high'] - df['low']).rolling(14).mean()

        # Отправляем запрос ИИ
        analysis = ai_market_analysis(df['close'].iloc[-1], df, "Управление сделкой", pos_info)

        if analysis and analysis.get("action") == "CLOSE":
            profit_threshold = -0.50
            if pos['profit'] >= profit_threshold:
                logger.info(f"🤖 AI: Закрываю сделку. Причина: {analysis['reason']}")
                if close_position(pos['ticket']):
                    with _lock:
                        trades = load_trades()
                        for t in trades:
                            if t.get("ticket") == pos['ticket']:
                                t["outcome"] = "win" if pos['profit'] > 0 else "loss"
                                t["auto_close_reason"] = analysis['reason']
                                self.stats["auto_pnl"] = round(self.stats.get("auto_pnl", 0) + pos['profit'], 2)
                                save_daily_stats(self.stats)
                        save_trades(trades)
            else:
                logger.info(f"🤖 AI: Надо бы закрыть, но убыток ({pos['profit']}) ниже порога -0.50$. Ждём.")
        elif analysis:
            logger.info(f"🤖 AI: Продолжаем держать сделку. ({analysis.get('reason', '')})")

    def run(self):
        global AUTO_TRADING_ENABLED
        logger.info("🤖 AutoTrader ЗАПУЩЕН (ожидание команды ВКЛ)")
        while True:
            try:
                if not AUTO_TRADING_ENABLED:
                    time.sleep(5)
                    continue

                if not init_mt5():
                    time.sleep(30)
                    continue

                # 1. Проверка открытых позиций и их сопровождение
                positions = get_positions()
                if positions:
                    self.manage_open_trades()
                    time.sleep(300) # Проверяем раз в 5 минут
                    continue

                # 2. Если позиций нет, проверяем возможность входа
                if not self.can_trade():
                    time.sleep(30)
                    continue

                rates = mt5.copy_rates_from_pos("XAUUSD", mt5.TIMEFRAME_M5, 0, 100)
                if rates is None: time.sleep(5); continue
                df = pd.DataFrame(rates)
                current_price = float(df['close'].iloc[-1])
                df['ema20'] = df['close'].ewm(span=20, adjust=False).mean()
                df['atr'] = (df['high'] - df['low']).rolling(14).mean()

                # Загружаем инсайты для контекста
                knowledge = load_knowledge()
                insights_summary = knowledge.get("summary", "Нейтральный рынок")

                # Запрос ИИ на открытие сделки
                analysis = ai_market_analysis(current_price, df, insights_summary, "Нет открытых позиций")

                if analysis and analysis.get("action") in ["BUY", "SELL"]:
                    signal = analysis["action"]
                    sl = analysis["sl"]
                    tp = analysis["tp"]

                    # Проверка SL/TP на валидность
                    if (signal == "BUY" and (sl >= current_price or tp <= current_price)) or \
                       (signal == "SELL" and (sl <= current_price or tp >= current_price)):
                        logger.warning(f"⚠️ AI предложил некорректные SL/TP. Игнорируем. SL:{sl}, TP:{tp}")
                        time.sleep(300)
                        continue

                    logger.info(f"🚀 AI: {signal} @ {current_price}, SL: {sl}, TP: {tp}. Reason: {analysis['reason']}")
                    result = open_order("XAUUSD", signal, current_price, sl, tp, LOT_SIZE)

                    if result.get("success"):
                        with _lock:
                            self.stats["auto_trades"] = self.stats.get("auto_trades", 0) + 1
                            self.last_trade_time = datetime.now(MSK)
                            save_daily_stats(self.stats)

                            trades = load_trades()
                            trades.append({
                                "ticket": result["ticket"],
                                "signal": signal,
                                "symbol": "XAUUSD",
                                "price": current_price,
                                "sl": sl,
                                "tp": tp,
                                "lot": LOT_SIZE,
                                "time": self.last_trade_time.strftime("%H:%M"),
                                "date": self.last_trade_time.strftime("%d.%m.%Y"),
                                "auto": True,
                                "ai_reason": analysis['reason']
                            })
                            save_trades(trades)
                        tg_send(f"🤖 AI Вход: {signal} XAUUSD\nЦена: {current_price}\nSL: {sl} | TP: {tp}\nПричина: {analysis['reason']}")
                    else:
                        logger.error(f"❌ Ошибка открытия: {result}")

                elif analysis:
                    logger.info(f"🤖 AI: Пока без входа. ({analysis.get('reason', '')})")

                time.sleep(300) # Цикл 5 минут

            except Exception as e:
                logger.error(f"⚠️ AutoTrader crash: {e}")
                time.sleep(60)

auto_trader = AutoTrader()

