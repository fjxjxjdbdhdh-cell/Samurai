    now = datetime.now(MSK)
    
    # NFP - первая пятница месяца в 15:30 МСК
    if now.weekday() == 4 and 1 <= now.day <= 7:
        if 15 <= now.hour <= 16:
            return True
    
    # Не торгуем в первые 30 минут рынка (понедельник открытие)
    if now.weekday() == 0 and now.hour < 10:
        return True
        
    return False


