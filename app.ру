<script>
let user = null;
let currentSym = 'XAUUSD';
let prevPrice = 0;

function switchPanel(name) {
    document.querySelectorAll('.panel').forEach(p => p.classList.remove('active'));
    document.querySelectorAll('.nav-i').forEach(n => n.classList.remove('active'));
    document.getElementById(name + 'Panel').classList.add('active');
    let panels = ['chart', 'status', 'terminal', 'vip', 'ai', 'account'];
    let idx = panels.indexOf(name);
    if (idx >= 0) document.querySelectorAll('.nav-i')[idx].classList.add('active');
    if (name === 'status') loadAccountStatus();
    if (name === 'terminal') loadHistory();
    if (name === 'vip' && user) loadVIPStatus();
}

function changeSym(sym) {
    currentSym = sym;
    document.querySelectorAll('.sym').forEach(s => s.classList.remove('active'));
    event.target.classList.add('active');
    updatePrices();
}

function showAuth() { document.getElementById('authModal').classList.add('active'); }
function closeAuth() { document.getElementById('authModal').classList.remove('active'); }

function api(url, options = {}) {
    return fetch(url, { headers: {'Content-Type': 'application/json'}, ...options }).then(r => r.json());
}

function login() {
    let e = document.getElementById('authEmail').value;
    let p = document.getElementById('authPass').value;
    api('/api/login', {method:'POST', body:JSON.stringify({email:e, password:p})}).then(d => {
        if (d.error) { document.getElementById('authMsg').textContent = d.error; return; }
        user = d;
        // Проверяем VIP статус
        checkVIPStatus();
        updateUI(); 
        closeAuth();
        localStorage.setItem('gm_user', JSON.stringify(d));
    });
}

function register() {
    let e = document.getElementById('authEmail').value;
    let p = document.getElementById('authPass').value;
    api('/api/register', {method:'POST', body:JSON.stringify({email:e, password:p})}).then(d => {
        if (d.error) { document.getElementById('authMsg').textContent = d.error; return; }
        user = d;
        updateUI(); 
        closeAuth();
        localStorage.setItem('gm_user', JSON.stringify(d));
    });
}

function checkVIPStatus() {
    if (!user) return;
    api('/api/vip/status?email=' + user.email).then(d => {
        if (d.tier === 'vip') {
            user.tier = 'vip';
            user.vip_expires = d.expires;
            user.vip_days_left = d.days_left;
            document.getElementById('vipStatus').textContent = '✅ VIP активен! ' + d.days_left + ' дн. до ' + d.expires;
        } else {
            document.getElementById('vipStatus').textContent = '🔒 Не активен';
        }
        updateUI();
    });
}

function updateUI() {
    let badge = '<span class="badge badge-free">FREE</span>';
    if (user && user.tier === 'vip') {
        let daysText = user.vip_days_left ? ' (' + user.vip_days_left + 'д)' : '';
        badge = '<span class="badge badge-vip">VIP' + daysText + '</span>';
    }
    if (user && user.tier === 'admin') badge = '<span class="badge badge-admin">ADMIN</span>';
    document.getElementById('userInfo').innerHTML = (user ? user.email.split('@')[0] : '🔐 Вход') + ' ' + badge;
}

function logout() {
    user = null;
    localStorage.removeItem('gm_user');
    document.getElementById('userInfo').textContent = '🔐 Вход';
}

function toggleAutoTrade() {
    if (!user) return alert('Войдите в аккаунт');
    if (user.tier !== 'vip' && user.tier !== 'admin') {
        return alert('❌ Только для VIP! Купите подписку за $19.99 USDT');
    }
    api('/api/autotrade/toggle', {method:'POST'}).then(d => {
        updateAutoUI(d.enabled);
    });
}

function emergencyStop() {
    if (!confirm('🛑 ЭКСТРЕННЫЙ СТОП!\nЗакрыть ВСЕ позиции и отключить авто-трейдинг?')) return;
    api('/api/emergency_stop', {method:'POST'}).then(d => {
        if (d.success) {
            alert('✅ Экстренный стоп! Закрыто позиций: ' + d.closed);
            updateAutoUI(false);
        }
    });
}

function updateAutoUI(enabled) {
    let btn = document.getElementById('autoTradeBtn');
    let status = document.getElementById('autoStatus');
    let emergencyBtn = document.getElementById('emergencyBtn');
    if (enabled) {
        btn.textContent = 'ВКЛ';
        btn.className = 'btn btn-on';
        status.textContent = 'Активен (поиск входа)';
        emergencyBtn.style.display = 'inline-block';
    } else {
        btn.textContent = 'ВЫКЛ';
        btn.className = 'btn btn-off';
        status.textContent = 'Отключен';
        emergencyBtn.style.display = 'none';
    }
}

function updatePrices() {
    api('/api/price?symbol=' + currentSym).then(d => {
        if (d.bid) {
            let p = ((d.bid + d.ask) / 2).toFixed(currentSym === 'XAUUSD' ? 2 : 5);
            document.getElementById('chartPrice').textContent = '$' + p;
            let change = prevPrice ? (p - prevPrice).toFixed(2) : '0.00';
            document.getElementById('priceChange').textContent = (change >= 0 ? '+' : '') + change;
            document.getElementById('priceChange').style.color = change >= 0 ? 'var(--green)' : 'var(--red)';
            prevPrice = p;
        }
    });
}
setInterval(updatePrices, 2000);

function doTrade(signal) {
    if (!user) return alert('Войдите в аккаунт');
    let lot = parseFloat(document.getElementById('lotSelect').value) || 0.02;
    let sl = parseFloat(document.getElementById('slInput').value) || 0;
    let tp = parseFloat(document.getElementById('tpInput').value) || 0;
    if (!sl || !tp) { alert('Введите Stop Loss и Take Profit'); return; }
    let price = parseFloat(document.getElementById('chartPrice').textContent.replace('$','')) || 0;
    if (!confirm('Открыть ' + signal + '?\nЛот: ' + lot + '\nSL: $' + sl + '\nTP: $' + tp + '\nЦена: $' + price)) return;
    api('/api/trade', {method:'POST', body:JSON.stringify({
        signal: signal, symbol: currentSym, price: price, sl: sl, tp: tp, lot: lot, username: user.email
    })}).then(d => {
        if (d.success) { alert('✅ Сделка открыта! Проверьте MT5.'); loadHistory(); }
        else { alert('❌ ' + d.error); }
    });
}

function payVIP() {
    if (!user) return alert('Войдите в аккаунт');
    let amount = '19.99';
    window.open('bybit://app/transfer?uid=495132302&amount=' + amount + '&coin=USDT', '_blank');
    setTimeout(() => {
        let txid = prompt('Введите ID транзакции из Bybit для активации VIP:');
        if (txid) {
            api('/api/vip/activate', {method:'POST', body:JSON.stringify({email: user.email, txid: txid})}).then(d => {
                if (d.success) {
                    alert('✅ VIP активирован до ' + d.expires + '!');
                    checkVIPStatus();
                } else {
                    alert('❌ ' + d.error);
                }
            });
        }
    }, 2000);
}

function loadVIPStatus() {
    if (user) checkVIPStatus();
}

function loadAccountStatus() {
    api('/api/account').then(d => {
        document.getElementById('accBalance').textContent = '$' + (d.balance || 0).toFixed(2);
        document.getElementById('accEquity').textContent = '$' + (d.equity || 0).toFixed(2);
        document.getElementById('accMargin').textContent = '$' + (d.margin || 0).toFixed(2);
        document.getElementById('accMarginFree').textContent = '$' + (d.margin_free || 0).toFixed(2);
        document.getElementById('accMarginLevel').textContent = (d.margin_level || 0).toFixed(2) + '%';
    });
    api('/api/positions').then(d => {
        let html = '';
        if (d.positions && d.positions.length > 0) {
            d.positions.forEach(p => {
                let cls = p.type === 'BUY' ? 'c-buy' : 'c-sell';
                html += '<div class="trade-row">';
                html += '<span class="' + cls + '">' + p.symbol + ' ' + p.type + ' ' + p.volume.toFixed(2) + '</span>';
                html += '<span>' + p.price_open.toFixed(2) + ' → ' + p.price_current.toFixed(2) + '</span>';
                html += '<span style="color:' + (p.profit >= 0 ? 'var(--green)' : 'var(--red)') + '">' + (p.profit >= 0 ? '+' : '') + p.profit.toFixed(2) + '</span>';
                html += '</div>';
            });
        } else { html = '<div class="trade-row">Нет открытых позиций</div>'; }
        document.getElementById('statusPositions').innerHTML = html;
    });
}
setInterval(() => { if (document.getElementById('statusPanel').classList.contains('active')) loadAccountStatus(); }, 2000);

function aiChat() {
    let msg = document.getElementById('chatInput').value;
    if (!msg) return;
    document.getElementById('chatBox').innerHTML += '<div style="color:var(--gold);margin:4px 0">Вы: ' + msg + '</div>';
    document.getElementById('chatInput').value = '';
    document.getElementById('chatBox').scrollTop = document.getElementById('chatBox').scrollHeight;
    api('/api/chat', {method:'POST', body:JSON.stringify({message: msg})}).then(d => {
        document.getElementById('chatBox').innerHTML += '<div style="color:#848e9c;margin:4px 0">AI: ' + (d.reply || '—') + '</div>';
        document.getElementById('chatBox').scrollTop = document.getElementById('chatBox').scrollHeight;
    });
}

function connectMT5() {
    let login = document.getElementById('mt5Login').value;
    let password = document.getElementById('mt5Pass').value;
    let server = document.getElementById('mt5Server').value;
    if (!login || !password) { alert('Введите логин и пароль MT5'); return; }
    document.getElementById('mt5Status').textContent = 'Подключение...';
    document.getElementById('mt5Status').style.color = 'var(--gold)';
    
    api('/api/mt5', {method:'POST', body:JSON.stringify({login: login, password: password, server: server})}).then(d => {
        if (d.message) {
            document.getElementById('mt5Status').textContent = d.message;
            document.getElementById('mt5Status').style.color = 'var(--green)';
        } else {
            document.getElementById('mt5Status').textContent = d.error || 'Ошибка подключения';
            document.getElementById('mt5Status').style.color = 'var(--red)';
        }
    }).catch(e => {
        document.getElementById('mt5Status').textContent = 'Ошибка сети';
        document.getElementById('mt5Status').style.color = 'var(--red)';
    });
}

function loadHistory() {
    api('/api/trades').then(d => {
        let html = '';
        if (d.trades && d.trades.length > 0) {
            d.trades.slice(0, 30).forEach(t => {
                let icon = t.auto ? '🤖' : '👆';
                let cls = t.signal === 'BUY' ? 'c-buy' : 'c-sell';
                let resultHtml = '';
                if (t.outcome === 'win') {
                    resultHtml = '<span style="color:var(--green)">+$' + (t.profit || '?') + '</span>';
                } else if (t.outcome === 'loss') {
                    resultHtml = '<span style="color:var(--red)">-$' + (t.profit || '?') + '</span>';
                } else if (t.outcome === 'timeout') {
                    resultHtml = '<span style="color:var(--gold)">⏰ Таймаут</span>';
                } else {
                    resultHtml = '<span style="color:#848e9c">Открыта</span>';
                }
                html += '<div class="trade-row">';
                html += '<span class="' + cls + '">' + icon + ' ' + t.signal + '</span>';
                html += '<span>' + (t.symbol || 'XAUUSD') + '</span>';
                html += '<span>$' + (t.price || 0).toFixed(2) + '</span>';
                html += '<span>' + (t.time || '—') + '</span>';
                html += resultHtml;
                html += '</div>';
            });
        } else { html = '<div class="trade-row">Нет сделок</div>'; }
        document.getElementById('histList').innerHTML = html;
    });
}

setInterval(() => {
    api('/api/stats').then(d => {
        document.getElementById('pnlVal').textContent = (d.auto_pnl >= 0 ? '+' : '') + '$' + Math.abs(d.auto_pnl || 0).toFixed(2);
        document.getElementById('tradesVal').textContent = (d.auto_trades || 0) + '/5';
    });
    api('/api/autotrade/status').then(d => updateAutoUI(d.enabled));
}, 5000);

let saved = localStorage.getItem('gm_user');
if (saved) {
    try {
        user = JSON.parse(saved);
        updateUI();
        checkVIPStatus();
        document.getElementById('authModal').classList.remove('active');
    } catch(e) {
        localStorage.removeItem('gm_user');
    }
}

api('/api/autotrade/status').then(d => updateAutoUI(d.enabled));

window.onload = function() {
