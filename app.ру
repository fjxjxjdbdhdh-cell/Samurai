class AutoTrader:
    def __init__(self):
        self.last_trade_time = None
        self.stats = load_daily_stats()
        self.last_mt5_check = datetime.now()
        self.trailing_last_run = datetime.now()
        self.last_trade_check = {}

    def mt5_health_check(self):
        """Проверка соединения с MT5 каждые 30 секунд"""
        now = datetime.now()
        if (now - self.last_mt5_check).seconds >= 30:
            self.last_mt5_check = now
            if not init_mt5():
                logger.error("⚠️ MT5 соединение потеряно! Пробую переподключиться...")
                init_mt5()

    def reset_daily(self):
        today = str(datetime.now(MSK).date())
        if self.stats.get("date") != today:
            self.stats = {"date": today, "auto_trades": 0, "auto_pnl": 0.0, "start_balance": 0.0}
            save_daily_stats(self.stats)
            self.last_trade_check = {}
            logger.info(f"🔄 Новый день! Сброс статистики.")
            global EMERGENCY_STOP
            EMERGENCY_STOP = False

    def can_trade(self):
        self.reset_daily()
        
        if EMERGENCY_STOP:
            logger.info("🛑 Экстренный стоп активен")
            return False
        
        acc = get_account_info()
        if acc.get('balance', 0) < MIN_BALANCE:
            logger.info(f"⚠️ Баланс ниже минимума (${MIN_BALANCE})")
            return False
        
        if not is_trading_session():
            return False
        
        if is_high_impact_news():
            logger.info(f"📰 Важные новости — пропускаем")
            return False
        
        spread = get_spread()
        if spread > MAX_SPREAD:
            logger.info(f"⚠️ Спред ${spread} > ${MAX_SPREAD} — не входим")
            return False
        
        if self.stats.get("auto_trades", 0) >= MAX_TRADES_PER_DAY:
            logger.info(f"⏸ Лимит сделок ({MAX_TRADES_PER_DAY})")
            return False
        if self.stats.get("auto_pnl", 0) >= DAILY_PROFIT_TARGET:
            logger.info(f"🏆 Дневной профит достигнут (+${DAILY_PROFIT_TARGET})")
            return False
        if self.stats.get("auto_pnl", 0) <= DAILY_LOSS_LIMIT:
            logger.info(f"🛑 Дневной лимит убытков (${DAILY_LOSS_LIMIT})")
            return False
        
        if self.check_daily_loss_percent():
            return False
        
        return True

    def check_daily_loss_percent(self):
        acc = get_account_info()
        balance = acc.get('balance', 200)
        start_balance = self.stats.get("start_balance", balance)
        if start_balance == 0:
            self.stats["start_balance"] = balance
            save_daily_stats(self.stats)
            return False
        pnl_percent = ((balance - start_balance) / start_balance) * 100 if start_balance > 0 else 0
        if pnl_percent <= MAX_DAILY_LOSS_PERCENT:
            global AUTO_TRADING_ENABLED, EMERGENCY_STOP
            AUTO_TRADING_ENABLED = False
            EMERGENCY_STOP = True
            close_all_positions()
            tg_send(f"🚨 *КРИТИЧЕСКИЙ УБЫТОК!*\nПотеря {pnl_percent:.2f}% депозита.\nВсе позиции закрыты.\nАвто-трейдинг ОТКЛЮЧЕН до 00:00 МСК.")
            return True
        return False

    def manage_open_trades(self):
        positions = get_positions()
        if not positions:
            return

        # Применяем трейлинг-стоп каждые 2 минуты
        now = datetime.now()
        if (now - self.trailing_last_run).seconds >= 120:
            self.trailing_last_run = now
            apply_trailing_stop()

        pos = positions[0]
        
        # Проверка таймаута сделки
        is_timeout, duration, trade_record = check_trade_timeout(pos)
        if is_timeout:
            if close_position(pos['ticket']):
                with _lock:
                    if trade_record:
                        trade_record["outcome"] = "timeout"
                        trade_record["profit"] = pos['profit']
                        trade_record["auto_close_reason"] = f"Таймаут {MAX_TRADE_DURATION_HOURS}ч (длительность: {str(duration).split('.')[0]})"
                    self.stats["auto_pnl"] = round(self.stats.get("auto_pnl", 0) + pos['profit'], 2)
                    save_daily_stats(self.stats)
                    trades = load_trades()
                    save_trades(trades)
                tg_notify_close(pos['type'], pos['profit'], f"Таймаут {MAX_TRADE_DURATION_HOURS}ч")
                return

        pos_info = (f"Тип: {pos['type']}, Открыта: {pos['price_open']}, "
                   f"Текущая: {pos['price_current']}, Прибыль: ${pos['profit']}, "
                   f"SL: {pos['sl']}, TP: {pos['tp']}")

        rates = mt5.copy_rates_from_pos("XAUUSD", mt5.TIMEFRAME_M5, 0, 50)
        if rates is None:
            return
        df = pd.DataFrame(rates)
        df['ema20'] = df['close'].ewm(span=20, adjust=False).mean()
        df['atr'] = (df['high'] - df['low']).rolling(14).mean()

        knowledge = load_knowledge()
        insights_summary = knowledge.get("summary", "Нейтральный рынок")

        analysis = ai_market_analysis(df['close'].iloc[-1], df, insights_summary, pos_info)

        if analysis and analysis.get("action") == "CLOSE":
            profit_threshold = -0.50
            if pos['profit'] >= profit_threshold:
                logger.info(f"🤖 AI: Закрываю сделку. Причина: {analysis['reason']}")
                if close_position(pos['ticket']):
                    with _lock:
                        trades = load_trades()
                        for t in trades:
                            if t.get("ticket") == pos['ticket']:
                                t["outcome"] = "win" if pos['profit'] > 0 else "loss"
                                t["auto_close_reason"] = analysis['reason']
                                t["profit"] = pos['profit']
                                self.stats["auto_pnl"] = round(self.stats.get("auto_pnl", 0) + pos['profit'], 2)
                                save_daily_stats(self.stats)
                        save_trades(trades)
                    tg_notify_close(pos['type'], pos['profit'], analysis['reason'])
            else:
                logger.info(f"🤖 AI: Убыток ({pos['profit']}) ниже порога -0.50$. Ждём.")

    def run(self):
        global AUTO_TRADING_ENABLED
        logger.info("╔══════════════════════════════════════════╗")
        logger.info("║  AutoTrader БОЕВОЙ РЕЖИМ v28.0         ║")
        logger.info(f"║  Спред макс: ${MAX_SPREAD}                     ║")
        logger.info(f"║  SL макс: ${MAX_SL_DISTANCE}                      ║")
        logger.info(f"║  Трейлинг: +${TRAILING_START} (мин. дист: ${MIN_TRAILING_DISTANCE}) ║")
        logger.info(f"║  Таймаут: {MAX_TRADE_DURATION_HOURS}ч                     ║")
        logger.info(f"║  Сессии: LON {LONDON_START}-{LONDON_END}, NY {NY_START}-{NY_END} МСК    ║")
        logger.info("╚══════════════════════════════════════════╝")
        
        while True:
            try:
                self.mt5_health_check()

                if not AUTO_TRADING_ENABLED or EMERGENCY_STOP:
                    time.sleep(5)
                    continue

                if not init_mt5():
                    time.sleep(30)
                    continue

                positions = get_positions()
                if positions:
                    self.manage_open_trades()
                    time.sleep(60)
                    continue

                if not self.can_trade():
                    time.sleep(60)
                    continue

                rates = mt5.copy_rates_from_pos("XAUUSD", mt5.TIMEFRAME_M5, 0, 100)
                if rates is None:
                    time.sleep(5)
                    continue
                df = pd.DataFrame(rates)
                current_price = float(df['close'].iloc[-1])
                df['ema20'] = df['close'].ewm(span=20, adjust=False).mean()
                df['atr'] = (df['high'] - df['low']).rolling(14).mean()

                delta = df['close'].diff()
                gain = delta.where(delta > 0, 0.0).rolling(14).mean()
                loss = (-delta.where(delta < 0, 0.0)).rolling(14).mean()
                rs_value = gain / loss
                df['rsi'] = 100.0 - (100.0 / (1.0 + rs_value))

                knowledge = load_knowledge()
                insights_summary = knowledge.get("summary", "Нейтральный рынок")

                analysis = ai_market_analysis(current_price, df, insights_summary, "Нет открытых позиций")

                if analysis and analysis.get("action") in ["BUY", "SELL"]:
                    signal = analysis["action"]
                    sl_raw = analysis["sl"]
                    tp = analysis["tp"]
                    
                    sl_distance = abs(current_price - sl_raw)
                    if sl_distance > MAX_SL_DISTANCE:
                        logger.warning(f"⚠️ SL слишком далеко (${sl_distance:.2f}). Корректирую.")
                        if signal == "BUY":
                            sl = round(current_price - MAX_SL_DISTANCE, 2)
                        else:
                            sl = round(current_price + MAX_SL_DISTANCE, 2)
                    else:
                        sl = sl_raw

                    if (signal == "BUY" and (sl >= current_price or tp <= current_price)) or \
                       (signal == "SELL" and (sl <= current_price or tp >= current_price)):
                        logger.warning(f"⚠️ Некорректные SL/TP. Пропускаю.")
                        time.sleep(300)
                        continue

                    spread = get_spread()
                    logger.info(f"🚀 ВХОД: {signal} @ {current_price}, SL: {sl}, TP: {tp}, Спред: ${spread}")
                    result = open_order("XAUUSD", signal, current_price, sl, tp, LOT_SIZE)

                    if result.get("success"):
                        with _lock:
                            self.stats["auto_trades"] = self.stats.get("auto_trades", 0) + 1
                            self.last_trade_time = datetime.now(MSK)
                            save_daily_stats(self.stats)

                            trades = load_trades()
                            trade_record = {
                                "ticket": result["ticket"],
                                "signal": signal,
                                "symbol": "XAUUSD",
                                "price": current_price,
                                "sl": sl,
                                "tp": tp,
                                "lot": LOT_SIZE,
                                "spread": spread,
                                "time": self.last_trade_time.strftime("%H:%M:%S"),
                                "date": self.last_trade_time.strftime("%d.%m.%Y"),
                                "auto": True,
                                "ai_reason": analysis['reason'],
                                "features": normalize_features(
                                    signal, current_price,
                                    float(df['rsi'].iloc[-1]),
                                    "UP" if signal == "BUY" else "DOWN",
                                    float(df['atr'].iloc[-1]),
                                ),
                            }
                            trades.append(trade_record)
                            save_trades(trades)

                            if not IS_DEMO:
                                add_commission("auto", LOT_SIZE)

                        tg_notify_trade(signal, current_price, sl, tp, analysis['reason'], spread)
                        maybe_run_ga(trades, load_weights())
                    else:
                        logger.error(f"❌ Ошибка открытия: {result}")

                elif analysis:
                    logger.info(f"🤖 AI: Жду. ({analysis.get('reason', '')})")

                time.sleep(300)

            except Exception as e:
                logger.error(f"⚠️ AutoTrader crash: {e}")
                time.sleep(60)


auto_trader = AutoTrader()


