def api_register():
    data = request.get_json() or {}
    email = data.get("email", "").strip()
    password = data.get("password", "")
    if not email or not password: return jsonify({"error": "Email и пароль обязательны"}), 400
    users = load_users()
    if email in users: return jsonify({"error": "Пользователь уже существует"}), 409
    tier = "admin" if email in ADMIN_EMAILS else "free"
    users[email] = {"password": hashlib.sha256(password.encode()).hexdigest(), "tier": tier}
    save_users(users)
    return jsonify({"email": email, "tier": tier})

@app.route("/api/login", methods=["POST"])
def api_login():
    data = request.get_json() or {}
    email = data.get("email", "").strip()
    password = data.get("password", "")
    if email in ADMIN_EMAILS:
        if password != ADMIN_EMAILS[email]: return jsonify({"error": "Неверный пароль администратора"}), 401
        users = load_users()
        if email not in users:
            users[email] = {"password": hashlib.sha256(password.encode()).hexdigest(), "tier": "admin"}
            save_users(users)
        return jsonify({"email": email, "tier": "admin"})
    users = load_users()
    if email not in users: return jsonify({"error": "Неверный email или пароль"}), 401
    if users[email]["password"] != hashlib.sha256(password.encode()).hexdigest(): return jsonify({"error": "Неверный email или пароль"}), 401
    return jsonify({"email": email, "tier": users[email].get("tier", "free")})

