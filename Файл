class ChatEngine:
    def __init__(self):
        self.history = []
        self.max_history = 50

    def generate_response(self, message: str, context: Dict = None) -> str:
        self.history.append({"role": "user", "content": message})
        msg = message.lower().strip()
        ctx = context or {}

        if msg.startswith('/'):
            response = self._handle_command(msg, ctx)
        else:
            response = self._smart_reply(msg, ctx)

        self.history.append({"role": "assistant", "content": response})
        if len(self.history) > self.max_history:
            self.history = self.history[-self.max_history:]
        return response

    def _handle_command(self, cmd: str, ctx: Dict) -> str:
        parts = cmd.split()
        command = parts[0].lower()
        if command == '/status':
            s = ctx.get('status', {})
            return f"📊 Режим: {s.get('mode','N/A')} | Сессия: {'✅' if s.get('session_active') else '❌'} | Позиций: {s.get('open_positions',0)} | PnL: {s.get('daily_pnl',0):.2f}$"
        if command == '/positions':
            pos = ctx.get('positions', [])
            return "📭 Позиций нет." if not pos else "📋 " + "\n".join(f"• {p['direction']} | Вход: {p['entry']:.2f} | PnL: {p.get('pnl',0):.2f}$" for p in pos)
        if command == '/signal':
            s = ctx.get('last_signal')
            return f"🔔 {s['direction']} | {s['pattern']} | R={s['r_ratio']:.1f} | Скор: {s.get('score','?')}" if s else "🔕 Сигналов нет."
        if command == '/help':
            return "📚 /status | /positions | /signal | /mode [aurum|manual] | /weekly | /report | /help"
        if command == '/weekly':
            r = ctx.get('weekly_report', {})
            return f"📅 Неделя: {r.get('trades',0)} сделок, PnL: {r.get('pnl',0):.2f}$, WR: {r.get('win_rate',0)*100:.0f}%"
        if command == '/report':
            r = ctx.get('analytics', {})
            return f"📊 Сделок: {r.get('total_trades',0)}, WR: {r.get('win_rate',0)*100:.0f}%, PF: {r.get('profit_factor',0):.1f}"
        return f"❓ {command} — неизвестно. /help для списка."

    def _smart_reply(self, msg: str, ctx: Dict) -> str:
        import random
        if any(w in msg for w in ['привет', 'здравствуй', 'hello']):
            return "👋 Привет! Я AURUM V3.0. Спрашивай о стратегии, рынке или давай поболтаем!"
        if any(w in msg for w in ['стратеги', 'aurum', 'как работаешь']):
            return "📖 AURUM V3.0: пробой консолидации на H1 в сторону тренда H4, подтверждённый объёмом и RSI дивергенцией. Цель ≥1.5R. Скоринг сигналов 0-9. Частичная фиксация на TP1."
        if any(w in msg for w in ['золото', 'рынок']):
            return f"📊 XAU/USD. Сессия: {'✅' if ctx.get('session_active') else '❌'}. Режим: {ctx.get('status',{}).get('regime','?')}."
        return random.choice(["🤔 Спрашивай — я здесь!", "Интересно! Расскажи подробнее.", "Я тут чтобы помочь."])

