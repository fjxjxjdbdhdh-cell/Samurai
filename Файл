        self.h1_candles = []
        self.m15_candles = []

    # ========== ИНИЦИАЛИЗАЦИЯ ==========

    def initialize(self):
        self.mt5.connect()
        self._load_state_from_db()
        self.event_bus.start()

    def _load_state_from_db(self):
        saved = self.persistence.load_all()
        if saved:
            self.signal_log = saved.get("signal_log", [])
            self.closed_trades_log = saved.get("closed_trades_log", [])
            logger.info("Сохранённое состояние загружено")

    # ========== РЫНОЧНЫЕ ДАННЫЕ ==========

    def update_market_data(self):
        try:
            import MetaTrader5 as mt5_module
            self.h4_candles = self.mt5.get_rates(SYMBOL, mt5_module.TIMEFRAME_H4 if hasattr(mt5_module, 'TIMEFRAME_H4') else 16388, 100)
            self.h1_candles = self.mt5.get_rates(SYMBOL, mt5_module.TIMEFRAME_H1 if hasattr(mt5_module, 'TIMEFRAME_H1') else 16385, 100)
            self.m15_candles = self.mt5.get_rates(SYMBOL, mt5_module.TIMEFRAME_M15 if hasattr(mt5_module, 'TIMEFRAME_M15') else 15, 100)
            self.market_intel.update(self.h4_candles, self.h1_candles, self.m15_candles)
        except:
            pass

    # ========== ПРИНЯТИЕ РЕШЕНИЙ ==========

    def think_and_decide(self):
        self.update_market_data()
        if self.mode == StrategyMode.MANUAL: return

        signal = self.aurum_engine.find_signal(self.h4_candles, self.h1_candles, self.m15_candles)
        if signal is None: return

        self.last_signal = signal
        avg_vol = sum(c.tick_volume for c in self.h1_candles[-6:-1]) / 5 if len(self.h1_candles) >= 6 else 1
        vol_ratio = self.h1_candles[-1].tick_volume / avg_vol if avg_vol > 0 else 1
        _, div_strength = self.aurum_engine.check_rsi_divergence(signal.direction)
        score = self.aurum_engine.score_signal(signal, vol_ratio, div_strength)

        self.log_signal_quality(signal, score)

        if score <= 2: return

        # Проверка дня недели
        if self.filter_by_day_of_week() == "skip": return

        if self.decision_engine.make_decision(signal, self.risk_engine):
            self.execute_trade(signal, score)

    # ========== ИСПОЛНЕНИЕ ==========

    def execute_trade(self, signal: TradeSignal, score: float = 5):
        if not self.safety_layer.is_execution_allowed(signal, self.positions): return None

        base_lot = self.risk_engine.calculate_position_size(signal.entry_price, signal.stop_loss)

        # Адаптивный лот
        if score >= 7: lot_mult = 1.0
        elif score >= 5: lot_mult = 0.6
        else: lot_mult = 0.3

        # Пятница — уменьшаем лот и TP
        if self.aurum_engine.check_friday_risk():
            lot_mult *= 0.5
            signal.take_profit = signal.entry_price + (signal.take_profit - signal.entry_price) * 0.7 if signal.direction == Direction.BUY else signal.entry_price - (signal.entry_price - signal.take_profit) * 0.7

        lot = max(0.01, round(base_lot * lot_mult, 2))
        lot = self.aurum_engine.calculate_dynamic_lot(lot, self.market_intel.volatility)
        lot = self.auto_compound_lot(lot)

        ticket = self.mt5.open_order(SYMBOL, "BUY" if signal.direction == Direction.BUY else "SELL",
                                     lot, sl=signal.stop_loss, tp=0, comment=f"AURUM_{signal.pattern}")

        if ticket is None: ticket = self.ticket_counter; self.ticket_counter += 1

        position = Position(ticket=ticket, direction=signal.direction, entry_price=signal.entry_price,
                            stop_loss=signal.stop_loss, take_profit=signal.take_profit, volume=lot,
                            open_time=datetime.now(), pattern=signal.pattern, tp1=signal.tp1)

        self.positions.append(position)
        self.signals_today += 1
        self.safety_layer.on_trade_executed(signal)
        self.position_tracker.update_position(ticket, {"direction": signal.direction.name, "entry": signal.entry_price,
                                                       "sl": signal.stop_loss, "tp": signal.take_profit})
        logger.info(f"✅ #{ticket}: {signal.direction.name} {signal.pattern} | Лот: {lot} | Скор: {score:.0f}/9 | SL: {signal.stop_loss:.2f}")
        return position

    # ========== УПРАВЛЕНИЕ ПОЗИЦИЯМИ ==========

    def manage_open_positions(self):
        for pos in self.positions[:]:
            price = self.mt5._get_real_price(SYMBOL, "BUY" if pos.direction == Direction.BUY else "SELL")
            if price == 0: continue

            # Обновляем экстремумы
            if pos.direction == Direction.BUY:
                pos.highest_price = max(pos.highest_price, price)
            else:
                pos.lowest_price = min(pos.lowest_price, price)

            tp1_hit = (pos.direction == Direction.BUY and price >= pos.tp1) or (pos.direction == Direction.SELL and price <= pos.tp1)
            tp2_hit = (pos.direction == Direction.BUY and price >= pos.take_profit) or (pos.direction == Direction.SELL and price <= pos.take_profit)

            if tp1_hit and not pos.is_breakeven:
                half_vol = round(pos.volume / 2, 2)
                if half_vol >= 0.01:
                    self.mt5.close_position(pos.ticket, half_vol)
                    pos.volume -= half_vol
                    profit_1r = (pos.tp1 - pos.entry_price) if pos.direction == Direction.BUY else (pos.entry_price - pos.tp1)
                    realized = profit_1r * half_vol * 100
                    self.daily_pnl += realized; self.weekly_pnl += realized
                    pos.tp1_hit = True
                    logger.info(f"TP1 #{pos.ticket}: +{realized:.2f}$ (50% закрыто, остаток в безубытке)")
                pos.stop_loss = pos.entry_price; pos.is_breakeven = True
                self.mt5.modify_position(pos.ticket, sl=pos.entry_price, tp=pos.take_profit)

            if tp2_hit:
                profit = (pos.take_profit - pos.entry_price) if pos.direction == Direction.BUY else (pos.entry_price - pos.take_profit)
                realized = profit * pos.volume * 100
                self._close_full_position(pos, price, "TP2")
                self.daily_pnl += realized; self.weekly_pnl += realized

            # Трейлинг-стоп
            if pos.is_breakeven:
                self.trail_all_positions()

    def trail_all_positions(self, trail_distance=1.5):
        for pos in self.positions:
            if not pos.is_breakeven: continue
            price = self.mt5._get_real_price(SYMBOL, "BUY" if pos.direction == Direction.BUY else "SELL")
            if price == 0: continue
            if self.aurum_engine.trail_stop(pos, price, trail_distance):
                self.mt5.modify_position(pos.ticket, sl=pos.stop_loss)

    def _close_full_position(self, pos: Position, price: float, reason: str):
        self.mt5.close_position(pos.ticket)
        profit = (price - pos.entry_price) if pos.direction == Direction.BUY else (pos.entry_price - price)
        realized = profit * pos.volume * 100
        self.daily_pnl += realized; self.weekly_pnl += realized; self.weekly_trades += 1
        self.positions.remove(pos)
        self.position_tracker.remove_position(pos.ticket)
        self.risk_engine.record_trade_result(realized)
        profit_for_stats = realized if pos.tp1_hit or reason == "TP2" else realized
        self.analytics_engine.record_trade_result({
            "ticket": pos.ticket, "profit": profit_for_stats if profit_for_stats > 0 else realized,
            "pattern": pos.pattern, "hour": datetime.now().hour,
            "day": datetime.now().strftime("%A"), "regime": self.market_intel.get_regime()
        })
        self.replay_closed_trades(pos, realized)
        logger.info(f"{reason} #{pos.ticket}: +{realized:.2f}$")

    # ========== НОВЫЕ МЕТОДЫ (12 функций) ==========

    def auto_compound_lot(self, base_lot):
        """Автоувеличение лота при росте депозита"""
        growth = self.risk_engine.current_balance / max(self.risk_engine.initial_balance, 1)
        return round(base_lot * min(growth, 2.0), 2)

    def daily_reset_stats(self):
        """Сброс дневной статистики в 00:00"""
        now = datetime.now()
        if now.hour == 0 and now.minute == 0:
            self.signals_today = 0; self.daily_pnl = 0.0
            logger.info("Дневная статистика сброшена")

    def weekly_report(self):
        """Сводка за неделю"""
        if (datetime.now() - self.last_weekly_reset).days >= 7:
            report = {"trades": self.weekly_trades, "pnl": self.weekly_pnl,
                      "win_rate": self.risk_engine.get_win_rate()}
            self.weekly_trades = 0; self.weekly_pnl = 0.0; self.last_weekly_reset = datetime.now()
            return report
        return {"trades": self.weekly_trades, "pnl": self.weekly_pnl, "win_rate": self.risk_engine.get_win_rate()}

    def check_drawdown_limit(self, max_drawdown_percent=15.0):
        """Стоп-торговля при просадке > N%"""
        dd = (self.risk_engine.initial_balance - self.risk_engine.current_balance) / self.risk_engine.initial_balance * 100
        if dd > max_drawdown_percent:
            self.safety_layer.activate_kill_switch(f"Просадка {dd:.1f}%")
            return True
        return False

    def emergency_reduce_lot(self):
        """Уменьшает лот вдвое после 3 убытков подряд"""
        if self.risk_engine.consecutive_losses >= 3:
            return 0.5
        return 1.0

    def get_best_trading_hours(self):
        return self.analytics_engine.get_best_trading_hours()

    def get_worst_trading_hours(self):
        return self.analytics_engine.get_worst_trading_hours()

    def filter_by_day_of_week(self):
        """Пропуск или уменьшение лота по дням"""
        day = datetime.now().strftime("%A")
        day_stats = self.analytics_engine.filter_by_day_of_week(day)
        if day_stats:
            avg_pnl = sum(day_stats) / len(day_stats)
            if avg_pnl < -50: return "skip"
            if avg_pnl < 0: return "reduce"
        return "normal"

    def adaptive_risk_per_trade(self):
        """Меняет % риска от винрейта"""
        wr = self.risk_engine.get_win_rate()
        if wr > 0.7: return self.risk_engine.max_risk_percent * 1.5
        if wr < 0.4: return self.risk_engine.max_risk_percent * 0.5
        return self.risk_engine.max_risk_percent

    def log_signal_quality(self, signal, score):
        """Записывает скор для анализа"""
        self.signal_log.append({
            "time": datetime.now().isoformat(),
            "pattern": signal.pattern,
            "direction": signal.direction.name,
            "score": score,
            "confidence": signal.confidence,
            "r_ratio": signal.r_ratio
        })
        if len(self.signal_log) > 1000: self.signal_log = self.signal_log[-500:]

    def replay_closed_trades(self, position, realized_pnl):
        """Анализ что пошло не так"""
        self.closed_trades_log.append({
            "ticket": position.ticket,
            "pattern": position.pattern,
            "direction": position.direction.name,
            "entry": position.entry_price,
            "tp": position.take_profit,
            "sl": position.stop_loss,
            "pnl": realized_pnl,
            "tp1_hit": position.tp1_hit,
            "open_time": position.open_time.isoformat(),
            "close_time": datetime.now().isoformat()
        })
        if len(self.closed_trades_log) > 500: self.closed_trades_log = self.closed_trades_log[-250:]

    # ========== ЧАТ И СТАТУС ==========

    def chat(self, message: str) -> str:
        msg_lower = message.lower().strip()
        if msg_lower.startswith('/mode'):
            parts = msg_lower.split()
            if len(parts) > 1:
                mode_map = {"aurum": StrategyMode.AURUM_V3, "manual": StrategyMode.MANUAL}
                if parts[1] in mode_map:
                    self.mode = mode_map[parts[1]]
                    return f"✅ Режим: **{self.mode.value.upper()}**"
            return "Укажите: /mode aurum, /mode manual"

        weekly = self.weekly_report()
        analytics = self.get_analytics_report()
        context = {
            "status": self.get_status(),
            "positions": [{"direction": p.direction.name, "entry": p.entry_price,
                           "sl": p.stop_loss, "tp": p.take_profit, "pnl": 0} for p in self.positions],
            "last_signal": {"direction": self.last_signal.direction.name, "pattern": self.last_signal.pattern,
                            "entry": self.last_signal.entry_price, "r_ratio": self.last_signal.r_ratio,
                            "score": self.signal_log[-1]["score"] if self.signal_log else 0} if self.last_signal else None,
            "session_active": self.aurum_engine.is_active_session(),
            "weekly_report": weekly,
            "analytics": analytics,
            "regime": self.market_intel.get_regime()
        }
        return self.chat_engine.generate_response(message, context)

    def get_status(self) -> Dict:
        return {
            "mode": self.mode.value,
            "session_active": self.aurum_engine.is_active_session(),
            "h4_context": self.aurum_engine.get_h4_context().name if self.h4_candles else "N/A",
            "open_positions": len(self.positions),
            "signals_today": self.signals_today,
            "daily_pnl": round(self.daily_pnl, 2),
            "risk_score": self.risk_engine.compute_portfolio_risk_score(),
            "market_regime": self.market_intel.get_regime()
        }

    def get_analytics_report(self) -> Dict:
        return self.analytics_engine.get_full_report()

    def get_full_institutional_report(self) -> Dict:
        weekly = self.weekly_report()
        return {
            "status": self.get_status(),
            "analytics": self.get_analytics_report(),
            "risk": self.risk_engine.get_full_risk_report(),
            "market": self.market_intel.get_market_summary(),
            "safety": self.safety_layer.get_safety_report(),
            "weekly": weekly,
            "signal_log_size": len(self.signal_log),
            "closed_trades_size": len(self.closed_trades_log)
        }

    # ========== АВТОТОРГОВЛЯ ==========

    def on_autotrade_start(self):
        self.is_running = True
        threading.Thread(target=self._main_loop, daemon=True).start()
        return "✅ Автоторговля запущена"

    def on_autotrade_stop(self):
        self.is_running = False
        return "⏹ Автоторговля остановлена"

    def _main_loop(self):
        while self.is_running:
            try:
                self.daily_reset_stats()
                self.check_drawdown_limit()
                self.think_and_decide()
                self.manage_open_positions()
            except Exception as e:
                logger.error(f"Ошибка цикла: {e}")
            time.sleep(60)

    def shutdown(self):
        self.is_running = False
        self.persistence.save_all({
            "analytics": self.analytics_engine,
            "risk": self.risk_engine,
            "signal_log": self.signal_log,
            "closed_trades_log": self.closed_trades_log
        })
        self.mt5.disconnect()
        self.event_bus.stop()

    def manual_kill_switch(self):
        self.safety_layer.activate_kill_switch("manual")
        return "KILL SWITCH активирован"

    def emergency_flatten(self):
        for pos in self.positions[:]:
            self.mt5.close_position(pos.ticket)
        self.positions.clear()
        return "Все позиции закрыты"

