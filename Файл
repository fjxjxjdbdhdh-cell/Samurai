class AurumStrategyEngine:
    def __init__(self):
        self.name = "AURUM_V3.0"
        self.symbol = SYMBOL
        self.h4_candles = []
        self.h1_candles = []
        self.m15_candles = []
        self.ema20_h4 = 0.0
        self.ema20_h1 = 0.0
        self.atr14_h1 = 0.0
        self.swing_highs_h4 = []
        self.swing_lows_h4 = []
        self.news_filter = NewsFilter()

    # ========== БАЗОВЫЕ МЕТОДЫ ==========

    def is_active_session(self):
        hour = datetime.utcnow().hour
        return (LONDON_START <= hour < LONDON_END) or (NY_START <= hour < NY_END)

    def get_session_priority(self):
        hour = datetime.utcnow().hour
        if NY_START <= hour < LONDON_END: return 2
        if LONDON_START <= hour < NY_START or LONDON_END <= hour < NY_END: return 1
        return 0

    def _calc_ema(self, candles, period):
        if len(candles) < period: return candles[-1].close if candles else 0.0
        closes = [c.close for c in candles]
        multiplier = 2.0 / (period + 1)
        ema = sum(closes[:period]) / period
        for price in closes[period:]: ema = (price - ema) * multiplier + ema
        return ema

    def _find_swing_points(self, candles, lookback=2):
        highs, lows = [], []
        for i in range(lookback, len(candles) - lookback):
            c = candles[i]
            if all(c.high > candles[i-j].high for j in range(1, lookback+1)) and all(c.high > candles[i+j].high for j in range(1, lookback+1)): highs.append(c.high)
            if all(c.low < candles[i-j].low for j in range(1, lookback+1)) and all(c.low < candles[i+j].low for j in range(1, lookback+1)): lows.append(c.low)
        return highs, lows

    def get_h4_context(self):
        if len(self.h4_candles) < 20: return Direction.NONE
        self.ema20_h4 = self._calc_ema(self.h4_candles, 20)
        self.swing_highs_h4, self.swing_lows_h4 = self._find_swing_points(self.h4_candles)
        price = self.h4_candles[-1].close
        if price > self.ema20_h4 and len(self.swing_highs_h4) >= 2 and len(self.swing_lows_h4) >= 2:
            if self.swing_highs_h4[-1] > self.swing_highs_h4[-2] and self.swing_lows_h4[-1] > self.swing_lows_h4[-2]: return Direction.BUY
        if price < self.ema20_h4 and len(self.swing_highs_h4) >= 2 and len(self.swing_lows_h4) >= 2:
            if self.swing_lows_h4[-1] < self.swing_lows_h4[-2] and self.swing_highs_h4[-1] < self.swing_highs_h4[-2]: return Direction.SELL
        return Direction.NONE

    def _calc_atr(self, candles, period=14):
        if len(candles) < period + 1: return candles[-1].high - candles[-1].low if candles else 0.0
        tr_list = []
        for i in range(1, len(candles)):
            c, p = candles[i], candles[i-1]
            tr = max(c.high - c.low, abs(c.high - p.close), abs(c.low - p.close))
            tr_list.append(tr)
        return sum(tr_list[-period:]) / period

    def _calc_rsi(self, candles, period=14):
        if len(candles) < period + 1: return 50.0
        closes = [c.close for c in candles]
        gains, losses = [], []
        for i in range(1, len(closes)):
            diff = closes[i] - closes[i-1]
            gains.append(max(diff, 0)); losses.append(max(-diff, 0))
        avg_gain = sum(gains[-period:]) / period
        avg_loss = sum(losses[-period:]) / period
        return 100.0 if avg_loss == 0 else 100.0 - (100.0 / (1.0 + avg_gain / avg_loss))

    # ========== ТРИГГЕРЫ T1-T3 ==========

    def detect_T1_inside_bar(self):
        if len(self.h1_candles) < 3: return None
        context = self.get_h4_context()
        if context == Direction.NONE: return None
        self.atr14_h1 = self._calc_atr(self.h1_candles)
        threshold = self.get_mb_threshold()
        for i in range(len(self.h1_candles) - 2, 1, -1):
            mb = self.h1_candles[i-1]; ib = self.h1_candles[i]
            if (mb.high - mb.low) < threshold * self.atr14_h1: continue
            if ib.high > mb.high or ib.low < mb.low: continue
            inner_count = 1
            for j in range(i-1, max(i-4, -1), -1):
                c = self.h1_candles[j]
                if c.high <= mb.high and c.low >= mb.low: inner_count += 1
                else: break
            if inner_count > 4: continue
            current = self.h1_candles[-1]
            if context == Direction.BUY and current.close > mb.high: return self._build_signal(Direction.BUY, current.close, mb.low, mb.high, "T1_InsideBar")
            if context == Direction.SELL and current.close < mb.low: return self._build_signal(Direction.SELL, current.close, mb.high, mb.low, "T1_InsideBar")
        return None

    def detect_T2_narrow_range(self):
        if len(self.h1_candles) < 6: return None
        context = self.get_h4_context()
        if context == Direction.NONE: return None
        for end_idx in range(len(self.h1_candles) - 1, 4, -1):
            for length in range(3, 6):
                start_idx = end_idx - length + 1
                if start_idx < 0: continue
                series = self.h1_candles[start_idx:end_idx+1]
                ranges = [c.high - c.low for c in series]
                if not all(ranges[j] <= ranges[j-1] for j in range(1, len(ranges))): continue
                nrh = max(c.high for c in series); nrl = min(c.low for c in series)
                current = self.h1_candles[-1]
                if context == Direction.BUY and current.close > nrh: return self._build_signal(Direction.BUY, current.close, nrl, nrh, "T2_NarrowRange")
                if context == Direction.SELL and current.close < nrl: return self._build_signal(Direction.SELL, current.close, nrh, nrl, "T2_NarrowRange")
        return None

    def detect_T3_ema_pullback(self):
        if len(self.h1_candles) < 20: return None
        context = self.get_h4_context()
        if context == Direction.NONE: return None
        self.ema20_h1 = self._calc_ema(self.h1_candles, 20)
        zone = 0.5
        for i in range(-3, 0):
            c = self.h1_candles[i]
            if context == Direction.BUY:
                if c.low <= self.ema20_h1 + zone and c.close > self.ema20_h1:
                    if min(c.open, c.close) - c.low > (c.high - c.low) * 0.3:
                        return self._build_signal(Direction.BUY, c.close, c.low - zone, self.swing_highs_h4[-1] if self.swing_highs_h4 else c.close + 2*self.atr14_h1, "T3_EMAPullback")
            else:
                if c.high >= self.ema20_h1 - zone and c.close < self.ema20_h1:
                    if c.high - max(c.open, c.close) > (c.high - c.low) * 0.3:
                        return self._build_signal(Direction.SELL, c.close, c.high + zone, self.swing_lows_h4[-1] if self.swing_lows_h4 else c.close - 2*self.atr14_h1, "T3_EMAPullback")
        return None

    # ========== НОВЫЕ ТРИГГЕРЫ T4-T6 ==========

    def detect_T4_fake_breakout(self):
        if len(self.h1_candles) < 4: return None
        context = self.get_h4_context()
        if context == Direction.NONE: return None
        current = self.h1_candles[-1]; prev = self.h1_candles[-2]; prev2 = self.h1_candles[-3]
        for level in self.swing_highs_h4 + self.swing_lows_h4:
            if prev2.close < level < prev.close and current.close < level and context == Direction.SELL:
                return self._build_signal(Direction.SELL, current.close, prev.high, level, "T4_FakeBreakout")
            if prev2.close > level > prev.close and current.close > level and context == Direction.BUY:
                return self._build_signal(Direction.BUY, current.close, prev.low, level, "T4_FakeBreakout")
        return None

    def detect_T5_momentum_breakout(self):
        """Пробой с ускорением: 3 бара подряд в одну сторону с растущим объёмом"""
        if len(self.h1_candles) < 5: return None
        context = self.get_h4_context()
        if context == Direction.NONE: return None
        last3 = self.h1_candles[-3:]
        if context == Direction.BUY:
            if all(c.close > c.open for c in last3) and all(last3[i].close > last3[i-1].close for i in range(1, 3)):
                if last3[-1].tick_volume > last3[-2].tick_volume > last3[-3].tick_volume:
                    return self._build_signal(Direction.BUY, last3[-1].close, last3[0].low, last3[-1].high + self._calc_atr(self.h1_candles), "T5_MomentumBreakout")
        else:
            if all(c.close < c.open for c in last3) and all(last3[i].close < last3[i-1].close for i in range(1, 3)):
                if last3[-1].tick_volume > last3[-2].tick_volume > last3[-3].tick_volume:
                    return self._build_signal(Direction.SELL, last3[-1].close, last3[0].high, last3[-1].low - self._calc_atr(self.h1_candles), "T5_MomentumBreakout")
        return None

    def detect_T6_opening_range_breakout(self):
        """Пробой первого часового диапазона Лондона (7:00-8:00 UTC)"""
        now = datetime.utcnow()
        if now.hour < 8 or now.hour > 16: return None
        context = self.get_h4_context()
        if context == Direction.NONE: return None
        london_open_candles = [c for c in self.h1_candles if c.time.hour == 7]
        if not london_open_candles: return None
        open_candle = london_open_candles[-1]
        range_high = open_candle.high; range_low = open_candle.low
        current = self.h1_candles[-1]
        if context == Direction.BUY and current.close > range_high:
            return self._build_signal(Direction.BUY, current.close, range_low, range_high + self._calc_atr(self.h1_candles), "T6_ORB")
        if context == Direction.SELL and current.close < range_low:
            return self._build_signal(Direction.SELL, current.close, range_high, range_low - self._calc_atr(self.h1_candles), "T6_ORB")
        return None

    # ========== ПРОВЕРКИ ==========

    def check_volume_confirmation(self):
        if len(self.h1_candles) < 6: return False
        return self.h1_candles[-1].tick_volume > sum(c.tick_volume for c in self.h1_candles[-6:-1]) / 5

    def check_rsi_divergence(self, direction):
        if len(self.m15_candles) < 20: return False, 0.0
        window = self.m15_candles[-15:]
        rsi_vals = [self._calc_rsi(window[max(0,i-7):i+1]) for i in range(7, len(window))]
        prices = [c.close for c in window[7:]]
        best_strength = 0.0
        if direction == Direction.BUY:
            for i in range(1, len(prices)-1):
                for j in range(i+1, len(prices)):
                    if prices[j] < prices[i] and rsi_vals[j] > rsi_vals[i]:
                        strength = (rsi_vals[j] - rsi_vals[i]) / 30.0
                        best_strength = max(best_strength, min(strength, 1.0))
        else:
            for i in range(1, len(prices)-1):
                for j in range(i+1, len(prices)):
                    if prices[j] > prices[i] and rsi_vals[j] < rsi_vals[i]:
                        strength = (rsi_vals[i] - rsi_vals[j]) / 30.0
                        best_strength = max(best_strength, min(strength, 1.0))
        return best_strength > 0.3, best_strength

    def check_target_sufficiency(self, signal):
        if not self.swing_highs_h4 or not self.swing_lows_h4:
            signal.r_ratio = 2.0; return True
        if signal.direction == Direction.BUY:
            targets = [h for h in self.swing_highs_h4 if h > signal.entry_price]
            if not targets: signal.r_ratio = 2.0; return True
            distance = min(targets) - signal.entry_price
            risk = signal.entry_price - signal.stop_loss
        else:
            targets = [l for l in self.swing_lows_h4 if l < signal.entry_price]
            if not targets: signal.r_ratio = 2.0; return True
            distance = signal.entry_price - min(targets, key=lambda x: signal.entry_price - x)
            risk = signal.stop_loss - signal.entry_price
        signal.r_ratio = distance / risk if risk > 0 else 2.0
        return signal.r_ratio >= 1.5

    def check_friday_risk(self):
        """Уменьшает лот и TP в пятницу"""
        return datetime.utcnow().weekday() == 4

    def check_monday_liquidity(self):
        """Ждёт первый час Лондона в понедельник"""
        now = datetime.utcnow()
        return now.weekday() == 0 and now.hour < 8

    def check_correlation(self, dxy_change=0.0):
        """Учёт индекса доллара: если DXY растёт, SELL по золоту приоритетнее"""
        if dxy_change > 0.1: return "bearish_gold"
        if dxy_change < -0.1: return "bullish_gold"
        return "neutral"

    # ========== СИГНАЛ И СКОРИНГ ==========

    def _build_signal(self, direction, entry, stop_level, breakout_level, pattern):
        risk = abs(entry - stop_level)
        if risk < 1.5: stop_level = entry - 1.5 if direction == Direction.BUY else entry + 1.5; risk = 1.5
        tp2 = entry + 2 * risk if direction == Direction.BUY else entry - 2 * risk
        if self.swing_highs_h4 and direction == Direction.BUY:
            targets = [h for h in self.swing_highs_h4 if h > entry]
            if targets: tp2 = min(entry + 2*risk, min(targets) - 0.2)
        if self.swing_lows_h4 and direction == Direction.SELL:
            targets = [l for l in self.swing_lows_h4 if l < entry]
            if targets: tp2 = max(entry - 2*risk, min(targets, key=lambda x: entry - x) + 0.2)
        tp1 = entry + risk if direction == Direction.BUY else entry - risk
        signal = TradeSignal(direction=direction, entry_price=entry, stop_loss=stop_level,
                             take_profit=tp2, pattern=pattern, confidence=0.8, r_ratio=2.0)
        signal.tp1 = tp1
        return signal

    def score_signal(self, signal, volume_ratio, divergence_strength):
        score = 0.0
        patterns = {"T1_InsideBar": 3.0, "T2_NarrowRange": 2.0, "T3_EMAPullback": 1.0,
                    "T4_FakeBreakout": 3.5, "T5_MomentumBreakout": 2.5, "T6_ORB": 2.0}
        score += patterns.get(signal.pattern, 1.0)
        if volume_ratio > 2.0: score += 2.0
        elif volume_ratio > 1.5: score += 1.0
        if divergence_strength > 0.8: score += 2.0
        elif divergence_strength > 0.5: score += 1.0
        if signal.r_ratio >= 2.5: score += 2.0
        elif signal.r_ratio >= 2.0: score += 1.0
        score += self.get_session_confidence()
        return max(0.0, min(9.0, score))

    # ========== НОВЫЕ МЕТОДЫ (22 функции) ==========

    def trail_stop(self, position, current_price, trail_distance=1.5):
        if position.direction == Direction.BUY:
            new_sl = current_price - trail_distance
            if new_sl > position.stop_loss: position.stop_loss = new_sl; return True
        else:
            new_sl = current_price + trail_distance
            if new_sl < position.stop_loss: position.stop_loss = new_sl; return True
        return False

    def get_mb_threshold(self):
        if len(self.h1_candles) < 20: return 0.7
        atr_now = self._calc_atr(self.h1_candles, 14)
        atr_old = self._calc_atr(self.h1_candles[:-20], 14) if len(self.h1_candles) > 20 else atr_now
        return 0.5 if atr_old > 0 and atr_now / atr_old < 0.7 else 0.7

    def filter_weak_levels(self, levels, min_touches=3):
        return [l for l in levels if sum(1 for c in self.h1_candles[-50:]
                if abs(c.high - l) < 0.5 or abs(c.low - l) < 0.5) >= min_touches]

    def get_volume_at_level(self, level, tolerance=0.5):
        return sum(c.tick_volume for c in self.h1_candles[-100:] if abs(c.close - level) < tolerance)

    def get_session_confidence(self):
        return 1.0 if self.get_session_priority() == 2 else 0.0

    def get_strongest_level(self, levels):
        if not levels: return None
        return max(levels, key=lambda l: self.get_volume_at_level(l))

    def get_atr_percentile(self):
        if len(self.h1_candles) < 100: return 50
        atrs = [self._calc_atr(self.h1_candles[i:i+14], 14) for i in range(len(self.h1_candles)-14)]
        current = self._calc_atr(self.h1_candles, 14)
        return sum(1 for a in atrs if a < current) / len(atrs) * 100

    def calculate_dynamic_lot(self, base_lot, volatility):
        percentile = self.get_atr_percentile()
        if percentile > 80: return base_lot * 0.5
        if percentile < 20: return base_lot * 1.5
        return base_lot

    def get_optimal_tp(self, entry, direction):
        atr = self._calc_atr(self.h1_candles, 14)
        if direction == Direction.BUY: return entry + atr * 2.5
        return entry - atr * 2.5

    def get_optimal_sl(self, entry, direction):
        atr = self._calc_atr(self.h1_candles, 14)
        if direction == Direction.BUY: return entry - atr * 1.2
        return entry + atr * 1.2

    def detect_divergence_strength(self, direction):
        _, strength = self.check_rsi_divergence(direction)
        return strength

    def get_volume_climax(self):
        """Детектит аномально большой объём (выше 3 сигм)"""
        if len(self.h1_candles) < 20: return False
        vols = [c.tick_volume for c in self.h1_candles[-20:]]
        mean = np.mean(vols); std = np.std(vols)
        return vols[-1] > mean + 3 * std

    def detect_absorption(self):
        """Большой объём но маленькое тело свечи — признак разворота"""
        if len(self.h1_candles) < 2: return None
        c = self.h1_candles[-1]
        body = abs(c.close - c.open)
        avg_body = np.mean([abs(self.h1_candles[i].close - self.h1_candles[i].open) for i in range(-20, -1)])
        if c.tick_volume > np.mean([x.tick_volume for x in self.h1_candles[-20:-1]]) * 2 and body < avg_body * 0.5:
            return "BUY" if c.close > c.open else "SELL"
        return None

    def get_swing_point_age(self):
        """Сколько часов назад был последний свинг-поинт"""
        if not self.h4_candles: return 999
        last_swing_time = self.h4_candles[-1].time
        for c in reversed(self.h4_candles):
            if c.high in self.swing_highs_h4 or c.low in self.swing_lows_h4:
                last_swing_time = c.time; break
        return (datetime.utcnow() - last_swing_time).total_seconds() / 3600

    def get_regime_confidence(self):
        """Насколько уверенно определён режим (0-1)"""
        if abs(self.trend_strength) > 0.05: return 0.9
        if abs(self.trend_strength) > 0.02: return 0.6
        return 0.3

    @property
    def trend_strength(self):
        if len(self.h4_candles) < 20: return 0.0
        closes = [c.close for c in self.h4_candles[-20:]]
        return np.polyfit(range(20), closes, 1)[0] / closes[-1] * 100

    # ========== ГЛАВНЫЙ ПОИСК СИГНАЛА ==========

    def find_signal(self, h4, h1, m15):
        self.h4_candles = h4; self.h1_candles = h1; self.m15_candles = m15

        if self.news_filter.is_news_near(): return None
        if self.check_monday_liquidity(): return None
        if not self.is_active_session(): return None
        if self.get_h4_context() == Direction.NONE: return None

        signal = None
        for detector in [self.detect_T1_inside_bar, self.detect_T2_narrow_range, self.detect_T3_ema_pullback,
                         self.detect_T4_fake_breakout, self.detect_T5_momentum_breakout, self.detect_T6_opening_range_breakout]:
            signal = detector()
            if signal: break

        if signal:
            if not self.check_volume_confirmation(): return None
            has_div, div_strength = self.check_rsi_divergence(signal.direction)
            if not has_div: return None
            if not self.check_target_sufficiency(signal): return None

            avg_vol = sum(c.tick_volume for c in self.h1_candles[-6:-1]) / 5 if len(self.h1_candles) >= 6 else 1
            vol_ratio = self.h1_candles[-1].tick_volume / avg_vol if avg_vol > 0 else 1
            score = self.score_signal(signal, vol_ratio, div_strength)
            signal.confidence = 0.6 + score * 0.04
            return signal

        return None

