class MT5Integration:
    _instances: Dict[str, 'MT5Integration'] = {}
    _lock = threading.Lock()

    def __new__(cls, connection_id: str = "default", **kwargs):
        with cls._lock:
            if connection_id not in cls._instances:
                instance = super().__new__(cls)
                instance._initialized = False
                cls._instances[connection_id] = instance
            return cls._instances[connection_id]

    def __init__(self, connection_id: str = "default", path=None, login=None, password=None, server=None):
        if self._initialized:
            return
        self.connection_id = connection_id
        self.path = path
        self.login = login
        self.password = password
        self.server = server
        self.connected = False
        self._mt5 = None
        try:
            import MetaTrader5 as mt5
            self._mt5 = mt5
        except ImportError:
            logger.warning("MetaTrader5 не установлен. Демо-режим.")
        self._initialized = True

    def connect(self) -> bool:
        if self._mt5 is None:
            self.connected = True
            return True
        try:
            if not self._mt5.initialize(path=self.path, login=self.login, password=self.password, server=self.server):
                logger.error(f"Ошибка MT5: {self._mt5.last_error()}")
                return False
            self.connected = True
            return True
        except Exception as e:
            logger.error(f"Исключение MT5: {e}")
            return False

    def disconnect(self):
        if self._mt5 and self.connected:
            self._mt5.shutdown()
            self.connected = False

    def reconnect(self) -> bool:
        self.disconnect()
        time.sleep(2)
        return self.connect()

    def get_account_info(self) -> Dict:
        if not self.connected or self._mt5 is None:
            return {"balance": 10000, "equity": 10000, "margin": 0, "free_margin": 10000}
        try:
            info = self._mt5.account_info()
            if info is None:
                return {}
            return {"balance": info.balance, "equity": info.equity, "margin": info.margin, "free_margin": info.margin_free}
        except:
            return {}

    def get_positions(self, symbol=None) -> List[Dict]:
        if not self.connected or self._mt5 is None:
            return []
        try:
            positions = self._mt5.positions_get(symbol=symbol) if symbol else self._mt5.positions_get()
            if positions is None:
                return []
            result = []
            for pos in positions:
                result.append({
                    "ticket": pos.ticket, "symbol": pos.symbol,
                    "type": "BUY" if pos.type == 0 else "SELL",
                    "volume": pos.volume, "open_price": pos.price_open,
                    "current_price": pos.price_current, "sl": pos.sl, "tp": pos.tp,
                    "profit": pos.profit, "open_time": datetime.fromtimestamp(pos.time)
                })
            return result
        except:
            return []

    def open_order(self, symbol: str, order_type: str, volume: float,
                   price=0.0, sl=0.0, tp=0.0, comment="AURUM") -> Optional[int]:
        if not self.connected or self._mt5 is None:
            import random
            return random.randint(10000, 99999)
        try:
            request = {
                "action": self._mt5.TRADE_ACTION_DEAL, "symbol": symbol, "volume": volume,
                "type": self._mt5.ORDER_TYPE_BUY if order_type.upper() == "BUY" else self._mt5.ORDER_TYPE_SELL,
                "price": price if price > 0 else self._get_real_price(symbol, order_type),
                "sl": sl, "tp": tp, "deviation": 20, "magic": MAGIC_NUMBER, "comment": comment,
                "type_time": self._mt5.ORDER_TIME_GTC, "type_filling": self._mt5.ORDER_FILLING_IOC,
            }
            result = self._mt5.order_send(request)
            if result.retcode != self._mt5.TRADE_RETCODE_DONE:
                logger.error(f"Ошибка ордера: {result.comment}")
                return None
            return result.order
        except:
            return None

    def close_position(self, ticket: int, volume=None) -> bool:
        if not self.connected or self._mt5 is None:
            return True
        try:
            pos = self._mt5.positions_get(ticket=ticket)
            if pos is None or len(pos) == 0:
                return False
            pos = pos[0]
            close_type = self._mt5.ORDER_TYPE_SELL if pos.type == 0 else self._mt5.ORDER_TYPE_BUY
            request = {
                "action": self._mt5.TRADE_ACTION_DEAL, "symbol": pos.symbol,
                "volume": volume if volume else pos.volume, "type": close_type, "position": ticket,
                "price": self._mt5.symbol_info_tick(pos.symbol).bid if close_type == self._mt5.ORDER_TYPE_SELL else self._mt5.symbol_info_tick(pos.symbol).ask,
                "deviation": 20, "magic": MAGIC_NUMBER, "comment": "Close AURUM",
                "type_time": self._mt5.ORDER_TIME_GTC, "type_filling": self._mt5.ORDER_FILLING_IOC,
            }
            result = self._mt5.order_send(request)
            if result.retcode != self._mt5.TRADE_RETCODE_DONE:
                logger.error(f"Ошибка закрытия: {result.comment}")
                return False
            return True
        except:
            return False

    def modify_position(self, ticket: int, sl=None, tp=None) -> bool:
        if not self.connected or self._mt5 is None:
            return True
        try:
            pos = self._mt5.positions_get(ticket=ticket)
            if pos is None or len(pos) == 0:
                return False
            pos = pos[0]
            request = {
                "action": self._mt5.TRADE_ACTION_SLTP, "position": ticket, "symbol": pos.symbol,
                "sl": sl if sl is not None else pos.sl, "tp": tp if tp is not None else pos.tp,
            }
            result = self._mt5.order_send(request)
            return result.retcode == self._mt5.TRADE_RETCODE_DONE
        except:
            return False

    def get_rates(self, symbol: str, timeframe, count: int = 100) -> List[Candle]:
        if not self.connected or self._mt5 is None:
            return self._generate_demo_rates(count)
        try:
            rates = self._mt5.copy_rates_from_pos(symbol, timeframe, 0, count)
            if rates is None:
                return []
            return [Candle(time=datetime.fromtimestamp(r['time']), open=r['open'], high=r['high'],
                           low=r['low'], close=r['close'], tick_volume=r['tick_volume'], spread=r['spread'])
                    for r in rates]
        except:
            return []

    def _get_real_price(self, symbol: str, order_type: str) -> float:
        if not self.connected or self._mt5 is None:
            return 2650.0
        try:
            tick = self._mt5.symbol_info_tick(symbol)
            if tick is None:
                return 0.0
            return tick.ask if order_type.upper() == "BUY" else tick.bid
        except:
            return 0.0

    def _generate_demo_rates(self, count: int) -> List[Candle]:
        import random
        candles = []
        price = 2650.0
        now = datetime.utcnow()
        for i in range(count):
            change = random.uniform(-3, 3)
            price += change
            candles.append(Candle(time=now - timedelta(hours=count-i),
                                  open=price - random.uniform(-1, 1), high=price + random.uniform(0.5, 2),
                                  low=price - random.uniform(0.5, 2), close=price,
                                  tick_volume=random.uniform(100, 1000)))
        return candles

